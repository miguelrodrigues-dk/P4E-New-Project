<%- include('../partials/header', { titulo: 'Editar evento | P4E' }) %>

<main class="container pagina-detalhes">
  <a class="link-voltar" href="/eventos/<%= evento.id %>">← Voltar aos detalhes</a>

  <section class="form-comentario form-novo-evento">
    <h1>Editar evento</h1>
    <p class="descricao-formulario">
      Atualize as informações abaixo para modificar os dados do evento no P4E.
    </p>

    <form action="/eventos/<%= evento.id %>/editar" method="POST">

      <label for="nome">Nome do evento</label>
      <input
        id="nome"
        name="nome"
        type="text"
        maxlength="100"
        value="<%= evento.nome %>"
        required
      >

      <label for="categoria">Categoria</label>
      <select id="categoria" name="categoria" required>
        <option value="">Selecione uma categoria</option>
        <% ['Música', 'Social', 'Cultura', 'Tecnologia', 'Esportes', 'Educação', 'Outro'].forEach(cat => { %>
          <option value="<%= cat %>" <%= evento.categoria === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>

      <label for="data">Data do evento</label>
      <input
        id="data"
        name="data"
        type="text"
        placeholder="DD/MM/AAAA"
        pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}"
        title="Informe a data no formato DD/MM/AAAA"
        value="<%= evento.data %>"
        required
      >

      <label for="local">Local</label>
      <input
        id="local"
        name="local"
        type="text"
        maxlength="150"
        value="<%= evento.local %>"
        required
      >

      <label for="descricao">Descrição</label>
      <textarea
        id="descricao"
        name="descricao"
        rows="5"
        maxlength="1500"
        required
      ><%= evento.descricao %></textarea>

      <!-- VISIBILIDADE: PÚBLICO OU PRIVADO -->
      <div class="opcao-destaque">
        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Visibilidade do evento</label>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <label style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; cursor: pointer;">
            <input type="radio" name="visibilidade" value="publico" <%= !evento.privado ? 'checked' : '' %>>
            <span>🌐 Público</span>
          </label>

          <label style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; cursor: pointer;">
            <input type="radio" name="visibilidade" value="privado" <%= evento.privado ? 'checked' : '' %>>
            <span>🔒 Privado</span>
          </label>
        </div>

        <p id="texto-ajuda-visibilidade" style="margin-top: 8px; font-size: 0.9rem; opacity: 0.85;"></p>
      </div>

      <div id="campo-imagem">
        <label for="imagem" id="label-imagem">URL da imagem de capa (opcional)</label>
        <input
          id="imagem"
          name="imagem"
          type="url"
          value="<%= evento.imagem %>"
          placeholder="https://exemplo.com"
        >
        <p class="ajuda-imagem">
          Aparece no banner da página de detalhes do evento (e no carrossel, se destacado).
        </p>
      </div>

      <div class="opcao-destaque" id="bloco-destaque">
        <label class="checkbox-destaque" for="destaque">
          <input
            id="destaque"
            name="destaque"
            type="checkbox"
            <%= evento.destaque ? 'checked' : '' %>
          >
          <span>Destacar este evento no carrossel</span>
        </label>

        <p>
          Marque esta opção somente se quiser exibir o evento no banner
          principal da página inicial.
        </p>
      </div>

      <div class="acoes-formulario">
        <button class="botao" type="submit">
          Salvar alterações
        </button>

        <a class="link-voltar" href="/eventos/<%= evento.id %>">
          Cancelar
        </a>
      </div>

    </form>
  </section>
</main>

<script>
  const radiosVisibilidade = document.querySelectorAll('input[name="visibilidade"]');
  const textoAjudaVisibilidade = document.getElementById('texto-ajuda-visibilidade');
  const blocoDestaque = document.getElementById('bloco-destaque');
  const checkboxDestaque = document.getElementById('destaque');
  const inputImagem = document.getElementById('imagem');
  const labelImagem = document.getElementById('label-imagem');

  function atualizarRequisitoImagem() {
    inputImagem.required = checkboxDestaque.checked;
    labelImagem.textContent = checkboxDestaque.checked
      ? 'URL da imagem de destaque (obrigatória para o carrossel)'
      : 'URL da imagem de capa (opcional)';
  }

  function atualizarVisibilidade() {
    const selecionado = document.querySelector('input[name="visibilidade"]:checked').value;
    const isPrivado = selecionado === 'privado';

    if (isPrivado) {
      textoAjudaVisibilidade.textContent = 'Privado: não aparece na lista pública nem no carrossel. Só você e quem receber o link podem ver.';
      blocoDestaque.hidden = true;
      checkboxDestaque.checked = false;
    } else {
      textoAjudaVisibilidade.textContent = 'Público: aparece na lista para todos os usuários e pode ir para o carrossel.';
      blocoDestaque.hidden = false;
    }
    atualizarRequisitoImagem();
  }

  radiosVisibilidade.forEach(radio => radio.addEventListener('change', atualizarVisibilidade));
  checkboxDestaque.addEventListener('change', atualizarRequisitoImagem);

  atualizarVisibilidade();
</script>

<script>
  const formulario = document.querySelector('.form-novo-evento form');
  const botaoEnviar = formulario.querySelector('button[type="submit"]');

  botaoEnviar.addEventListener('click', function () {
    const campoInvalido = formulario.querySelector(':invalid');
    if (campoInvalido) {
      campoInvalido.scrollIntoView({ behavior: 'instant', block: 'center' });
      setTimeout(() => {
        campoInvalido.reportValidity();
      }, 50);
    }
  });
</script>


<%- include('../partials/footer') %>
